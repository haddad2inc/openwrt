name: Build OpenWrt for COMFAST CF-WA350 (with config diff)

on:
  workflow_dispatch:
  push:
    branches: [ main ]

env:
  REPO_URL: https://git.openwrt.org/openwrt/openwrt.git
  # تم إزالة تحديد الفرع ليتم بناء سناب شوت (الفرع الافتراضي master)
  TZ: Asia/Riyadh

jobs:
  build:
    runs-on: ubuntu-22.04
    permissions:
      contents: write

    steps:
    - name: Checkout your repo
      uses: actions/checkout@v4
      with:
        fetch-depth: 0

    - name: Check disk space before build
      run: |
        echo "=== Disk space before build ==="
        df -h
        du -sh . 2>/dev/null || true

    - name: Initialize build log
      run: |
        echo "=== BUILD LOG - $(date) ===" > build.log
        echo "Workflow triggered by: ${{ github.event_name }}" >> build.log
        echo "Repository: ${{ github.repository }}" >> build.log
        echo "Branch: ${{ github.ref_name }}" >> build.log
        echo "Commit: ${{ github.sha }}" >> build.log
        echo "========================================" >> build.log
        echo "Build started at: $(date)" >> build.log
        echo "========================================" >> build.log
        git config user.name "github-actions[bot]"
        git config user.email "github-actions[bot]@users.noreply.github.com"
        git add build.log
        git commit -m "Initialize build log for run ${{ github.run_id }}" || true
        git push origin main || true

    - name: Check if .config exists in repo root
      run: |
        echo "=== Checking for .config file ===" | tee -a build.log
        if [ -f .config ]; then
          echo "✅ .config file found in repository root." | tee -a build.log
        else
          echo "❌ ERROR: .config file not found in repository root!" | tee -a build.log
          exit 1
        fi

    - name: Initialize environment
      run: |
        echo "=== Initializing environment ===" | tee -a build.log
        sudo apt update 2>&1 | tee -a build.log
        sudo apt install -y build-essential clang flex bison g++ gawk \
          gcc-multilib g++-multilib gettext libncurses5-dev libssl-dev \
          python3-distutils rsync unzip zlib1g-dev file wget curl \
          libelf-dev autoconf automake libtool binutils bzip2 \
          diffutils patch perl sed xz-utils coreutils findutils bash 2>&1 | tee -a build.log
        sudo apt clean 2>&1 | tee -a build.log
        sudo rm -rf /var/lib/apt/lists/* 2>&1 | tee -a build.log

    - name: Clone OpenWrt source (shallow)
      run: |
        echo "=== Cloning OpenWrt source ===" | tee -a build.log
        git clone --depth 1 $REPO_URL openwrt 2>&1 | tee -a build.log
        rm -rf openwrt/.git 2>&1 | tee -a build.log

    - name: Update & Install feeds
      run: |
        echo "=== Updating and installing feeds ===" | tee -a build.log
        cd openwrt
        ./scripts/feeds update -a 2>&1 | tee -a ../build.log
        ./scripts/feeds install -a 2>&1 | tee -a ../build.log

    - name: Apply patches via Python script
      run: |
        echo "=== Applying patches ===" | tee -a build.log
        python3 apply_patches.py 2>&1 | tee -a build.log

    - name: Inject custom files
      run: |
        echo "=== Injecting custom files ===" | tee -a build.log
        if [ -d files ]; then
          mkdir -p openwrt/files
          cp -rv files/* openwrt/files/ 2>&1 | tee -a build.log
        else
          echo "No 'files' directory found." | tee -a build.log
        fi

    - name: Import cfw-leds package into openwrt/package/utils/
      run: |
        echo "=== Importing cfw-leds package ===" | tee -a build.log
        CFW_REPO="https://github.com/haddad2inc/cfw-leds.git"
        TARGET_PARENT="openwrt/package/utils"
        TARGET_DIR="$TARGET_PARENT/cfw-leds"
        TMP_DIR="/tmp/cfw-leds-src"

        echo "Repo: $CFW_REPO" | tee -a build.log
        echo "Target parent: $TARGET_PARENT" | tee -a build.log
        echo "Expected final path: $TARGET_DIR" | tee -a build.log

        rm -rf "$TMP_DIR"
        if git clone --depth 1 "$CFW_REPO" "$TMP_DIR" 2>&1 | tee -a build.log; then
          echo "✅ Clone succeeded." | tee -a build.log
        else
          echo "❌ Clone FAILED." | tee -a build.log
          exit 1
        fi

        rm -rf "$TMP_DIR/.git"

        # المستودع يحتوي على مجلد فرعي باسم cfw-leds، ننسخ المجلد نفسه (وليس محتوياته)
        SRC_DIR="$TMP_DIR/cfw-leds"
        if [ ! -d "$SRC_DIR" ]; then
          echo "❌ ERROR: Expected subfolder '$SRC_DIR' not found." | tee -a build.log
          echo "--- Listing TMP_DIR contents ---" | tee -a build.log
          ls -la "$TMP_DIR" | tee -a build.log
          exit 1
        fi

        # التأكد من وجود المجلد الأب
        mkdir -p "$TARGET_PARENT"

        # إزالة أي نسخة سابقة لتجنب التعارض
        rm -rf "$TARGET_DIR"

        # نسخ المجلد cfw-leds بكامله إلى openwrt/package/utils/
        if cp -rv "$SRC_DIR" "$TARGET_PARENT"/ 2>&1 | tee -a build.log; then
          echo "✅ Copy to $TARGET_PARENT succeeded." | tee -a build.log
        else
          echo "❌ Copy FAILED." | tee -a build.log
          exit 1
        fi

        echo "=== Listing imported files ===" | tee -a build.log
        find "$TARGET_DIR" -type f -exec ls -lh {} \; 2>&1 | tee -a build.log

        echo "=== Applying permissions ===" | tee -a build.log
        chmod -R u+rwX,go+rX "$TARGET_DIR" 2>&1 | tee -a build.log
        find "$TARGET_DIR" -type f -name "*.sh" -exec chmod +x {} \; 2>&1 | tee -a build.log
        find "$TARGET_DIR" -type f -name "Makefile" -exec chmod 644 {} \; 2>&1 | tee -a build.log
        find "$TARGET_DIR/files" -type f -exec chmod +x {} \; 2>/dev/null || true

        echo "=== Verifying Makefile presence ===" | tee -a build.log
        if [ -f "$TARGET_DIR/Makefile" ]; then
          echo "✅ Makefile found at $TARGET_DIR/Makefile" | tee -a build.log
          echo "--- Makefile header (first 20 lines) ---" | tee -a build.log
          head -n 20 "$TARGET_DIR/Makefile" | tee -a build.log
        else
          echo "❌ ERROR: Makefile NOT found in $TARGET_DIR" | tee -a build.log
          exit 1
        fi

        echo "✅ cfw-leds package import completed." | tee -a build.log

    - name: Copy .config and verify active options
      run: |
        echo "=== Copying .config from repository root to openwrt/ ===" | tee -a build.log
        cp -v .config openwrt/.config 2>&1 | tee -a build.log

        cd openwrt

        # 1. حفظ نسخة من .config قبل أي تعديل
        cp .config config-before.txt

        # 2. طباعة الخيارات المفعّلة في الملف المستورد (قبل defconfig)
        echo "=== Active options BEFORE defconfig (imported from repo) ===" | tee -a ../build.log
        echo "Count of enabled options (y/m):" | tee -a ../build.log
        grep -E '^CONFIG_.*=[ym]' .config | wc -l | tee -a ../build.log
        echo "Listing all enabled options:" | tee -a ../build.log
        grep -E '^CONFIG_.*=[ym]' .config | sort | tee -a ../build.log

        # 3. التحقق من وجود الجهاز المستهدف قبل defconfig
        echo "=== Checking target device BEFORE defconfig ===" | tee -a ../build.log
        if grep -q "CONFIG_TARGET_ath79_generic_DEVICE_comfast_cf-wa350=y" .config; then
          echo "✅ Target device correctly set BEFORE defconfig." | tee -a ../build.log
        else
          echo "⚠️ Target device NOT set BEFORE defconfig. It will be added after." | tee -a ../build.log
        fi

        # 4. تشغيل olddefconfig (للحفاظ على الاختيارات)
        echo "=== Running make olddefconfig ===" | tee -a ../build.log
        make olddefconfig 2>&1 | tee -a ../build.log

        # 5. تشغيل defconfig (لحل التبعيات)
        echo "=== Running make defconfig ===" | tee -a ../build.log
        make defconfig 2>&1 | tee -a ../build.log

        # 6. حفظ نسخة من .config بعد defconfig
        cp .config config-after.txt

        # 7. إعادة فرض الجهاز المستهدف إذا فُقد
        echo "=== Checking target device AFTER defconfig ===" | tee -a ../build.log
        if ! grep -q "CONFIG_TARGET_ath79_generic_DEVICE_comfast_cf-wa350=y" .config; then
          echo "⚠️ Target device option missing after defconfig, re-adding..." | tee -a ../build.log
          echo "CONFIG_TARGET_ath79=y" >> .config
          echo "CONFIG_TARGET_ath79_generic=y" >> .config
          echo "CONFIG_TARGET_ath79_generic_DEVICE_comfast_cf-wa350=y" >> .config
          # نعيد defconfig مرة أخرى لتحديث التبعيات
          make defconfig 2>&1 | tee -a ../build.log
          # تحديث نسخة config-after.txt بعد الإضافة
          cp .config config-after.txt
        else
          echo "✅ Target device still correctly set AFTER defconfig." | tee -a ../build.log
        fi

        # 8. طباعة الخيارات المفعّلة بعد defconfig
        echo "=== Active options AFTER defconfig ===" | tee -a ../build.log
        echo "Count of enabled options (y/m):" | tee -a ../build.log
        grep -E '^CONFIG_.*=[ym]' .config | wc -l | tee -a ../build.log
        echo "Listing all enabled options:" | tee -a ../build.log
        grep -E '^CONFIG_.*=[ym]' .config | sort | tee -a ../build.log

        # 9. عرض الفروقات بين config-before.txt و config-after.txt (مع تجاهل التعليقات والأسطر الفارغة)
        echo "=== Diff between BEFORE and AFTER defconfig (ignoring comments/empty lines) ===" | tee -a ../build.log
        diff -u <(grep -v '^#' config-before.txt | grep -v '^$' | sort) \
               <(grep -v '^#' config-after.txt | grep -v '^$' | sort) 2>&1 | tee -a ../build.log || true

        # 10. التحقق من خيارات بناء الصورة الأساسية
        echo "=== Checking essential image build options AFTER defconfig ===" | tee -a ../build.log
        for opt in CONFIG_TARGET_ROOTFS_SQUASHFS CONFIG_TARGET_ROOTFS_INITRAMFS; do
          if grep -q "$opt=y" .config; then
            echo "✅ $opt is enabled." | tee -a ../build.log
          else
            echo "⚠️ $opt is NOT enabled. This may result in missing firmware files." | tee -a ../build.log
          fi
        done

        echo "✅ .config verification completed." | tee -a ../build.log

    - name: Upload config snapshots (before/after)
      if: always()
      uses: actions/upload-artifact@v4
      with:
        name: config-snapshots
        path: |
          openwrt/config-before.txt
          openwrt/config-after.txt
        if-no-files-found: warn

    - name: Download package sources
      run: |
        echo "=== Downloading package sources ===" | tee -a build.log
        cd openwrt
        make download -j$(nproc) 2>&1 | tee -a ../build.log
        find dl -size -1024c -exec rm -f {} \; 2>&1 | tee -a ../build.log
        rm -rf dl/*.tmp 2>&1 | tee -a ../build.log

    - name: Clean previous build artifacts (if any)
      run: |
        echo "=== Cleaning previous build artifacts ===" | tee -a build.log
        cd openwrt
        rm -rf build_dir staging_dir 2>&1 | tee -a ../build.log

    - name: Build OpenWrt (single job to reduce disk usage)
      run: |
        echo "=== Building OpenWrt ===" | tee -a build.log
        echo "Build started at: $(date)" | tee -a build.log
        cd openwrt
        make -j1 V=s 2>&1 | tee -a ../build.log
        echo "Build finished at: $(date)" | tee -a build.log
      timeout-minutes: 360

    - name: List all files in bin/targets/ath79/generic/
      run: |
        echo "=== Contents of bin/targets/ath79/generic/ ===" | tee -a build.log
        cd openwrt
        if [ -d bin/targets/ath79/generic/ ]; then
          ls -la bin/targets/ath79/generic/ 2>&1 | tee -a ../build.log
          find bin/targets/ath79/generic/ -type f -exec ls -lh {} \; 2>&1 | tee -a ../build.log
          if [ -z "$(find bin/targets/ath79/generic/ -name '*.bin' -o -name '*.img' -o -name '*.tar' 2>/dev/null)" ]; then
            echo "⚠️ No firmware files found. Attempting to build image separately..." | tee -a ../build.log
            make target/install 2>&1 | tee -a ../build.log
            ls -la bin/targets/ath79/generic/ 2>&1 | tee -a ../build.log
          fi
        else
          echo "❌ Directory bin/targets/ath79/generic/ does not exist!" | tee -a ../build.log
        fi

    - name: Clean temporary build directories (free space for packaging)
      run: |
        echo "=== Cleaning build_dir and staging_dir ===" | tee -a build.log
        cd openwrt
        rm -rf build_dir staging_dir 2>&1 | tee -a ../build.log

    - name: Check disk space after build
      run: |
        echo "=== Disk space after build ===" | tee -a build.log
        df -h 2>&1 | tee -a build.log
        du -sh openwrt 2>&1 | tee -a build.log || true

    - name: Upload log to repository (always)
      if: always()
      run: |
        echo "=== Uploading log to repository ===" >> build.log
        echo "=== BUILD LOG END - $(date) ===" >> build.log
        echo "Build completed with status: ${{ job.status }}" >> build.log
        git config user.name "github-actions[bot]"
        git config user.email "github-actions[bot]@users.noreply.github.com"
        git add build.log
        git commit -m "Update build log for run ${{ github.run_id }}" || true
        git push origin main || true

    - name: Upload full log as artifact (always)
      if: always()
      uses: actions/upload-artifact@v4
      with:
        name: full-build-log
        path: build.log
        if-no-files-found: error

    - name: Upload firmware and all build artifacts
      if: always()
      uses: actions/upload-artifact@v4
      with:
        name: openwrt-firmware-full
        path: |
          openwrt/bin/targets/ath79/generic/
        if-no-files-found: warn
