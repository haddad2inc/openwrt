#include "qca956x.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "COMFAST CF-WA350";
	compatible = "comfast,cf-wa350", "qca,qca9563";

	aliases {
		label-mac-device = &eth0;
		led-boot = &led_lan;
		led-failsafe = &led_lan;
		led-running = &led_lan;
		led-upgrade = &led_lan;
	};

	leds {
		compatible = "gpio-leds";

		led_lan: lan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&gpio 17 GPIO_ACTIVE_HIGH>;
		};

		wan {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&gpio 15 GPIO_ACTIVE_HIGH>;
		};

		wlan5g {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN_5GHZ;
			gpios = <&gpio 16 GPIO_ACTIVE_HIGH>;
		};

		ext_wan {
			color = <LED_COLOR_ID_BLUE>;
			function = "ext-wan";
			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
		};

		ext_wlan2g {
			color = <LED_COLOR_ID_BLUE>;
			function = "ext-wlan2g";
			gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
		};

		ext_lan {
			color = <LED_COLOR_ID_BLUE>;
			function = "ext-lan";
			gpios = <&gpio 21 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	watchdog {
		compatible = "linux,wdt-gpio";
		gpios = <&gpio 6 GPIO_ACTIVE_HIGH>;
		hw_algo = "toggle";
		hw_margin_ms = <500>;
		always-running;
	};
};

&pcie {
	status = "okay";

	wifi@0,0 {
		compatible = "qcom,ath10k";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&precal_art_5000>, <&macaddr_art_0 2>;
		nvmem-cell-names = "pre-calibration", "mac-address";
	};
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			partition@40000 {
				label = "art";
				reg = <0x040000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_art_0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};

					cal_art_1000: calibration@1000 {
						reg = <0x1000 0x440>;
					};

					precal_art_5000: pre-calibration@5000 {
						reg = <0x5000 0x2f20>;
					};
				};
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x050000 0xfa0000>;
			};

			partition@ff0000 {
				label = "art-backup";
				reg = <0xff0000 0x010000>;
				read-only;
			};
		};
	};
};

/*
 * QCA8337 (AR8337 rev. 2): qca8k reaches the switch registers through the
 * hardcoded MDIO window 0x10-0x18, while the five port PHYs answer at 0-4.
 * Anchor the switch node at 0x10 so it does not collide with PHY 0.
 *
 * No PHY is declared on the external ag71xx bus and no "mdio" child is
 * declared here, so qca8k uses its legacy port-to-PHY mapping (port N ->
 * internal PHY N - 1) and registers "qca8k-legacy user mii" as
 * ds->user_mii_bus. All PHY traffic then goes through the switch MDIO
 * master, which also disconnects the external MDC/MDIO passthrough.
 *
 * This is what keeps CONFIG_AR8216_PHY - built into every ath79 kernel on
 * the generic subtarget - away from the switch: the legacy bus enumerates
 * the PHYs at the *port* addresses (1 and 2), and ar8xxx_phy_probe() only
 * ever looks at MDIO addresses 0, 3 and 4, so it returns -ENODEV without
 * reading a single register. With PHY nodes on the external bus instead,
 * that driver identifies the chip through its 0x10/0x18 window, registers a
 * bogus swconfig switch and only then fails on the missing
 * qca,ar8327-initvals.
 */
&mdio0 {
	status = "okay";

	ethernet-switch@10 {
		compatible = "qca,qca8337";
		reg = <0x10>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@0 {
				reg = <0>;
				ethernet = <&eth0>;
				phy-mode = "sgmii";

				/*
				 * Stock firmware programs PORT0_PAD_MODE_CTRL (0x04)
				 * with 0x00080080: BIT(7) enables SGMII (handled via
				 * phy-mode) and BIT(19) selects the SGMII RX clock
				 * falling edge, which this board requires.
				 * PORT0_STATUS (0x7c) = 0x7e is covered by fixed-link.
				 * qca,sgmii-enable-pll is deliberately omitted: the
				 * binding advises it for a QCA8337 SGMII CPU port, but
				 * this board's CPU link is stable at 1G without it.
				 */
				qca,sgmii-rxclk-falling-edge;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			ethernet-port@1 {
				reg = <1>;
				label = "wan";
				phy-mode = "internal";
			};

			ethernet-port@2 {
				reg = <2>;
				label = "lan";
				phy-mode = "internal";
			};
		};
	};
};

&wdt {
	status = "disabled";
};

&eth0 {
	status = "okay";

	pll-data = <0x03000101 0x00000101 0x00001919>;

	phy-mode = "sgmii";
	nvmem-cells = <&macaddr_art_0 0>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&wmac {
	status = "okay";

	nvmem-cells = <&macaddr_art_0 10>, <&cal_art_1000>;
	nvmem-cell-names = "mac-address", "calibration";
};
